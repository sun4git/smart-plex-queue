# Smart Plex Queue - Dashboard (systemd unit)
#
# Install:
#   sudo cp smart-plex-queue-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smart-plex-queue-dashboard.service
#
# Before installing, edit User= and WorkingDirectory= below to match your
# box, and confirm the ExecStart= python3 path with `which python3`.

[Unit]
Description=Smart Plex Queue - Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=suneel
WorkingDirectory=/home/suneel/sunwork/apps/smart-plex-queue
Environment=PYTHONUTF8=1
ExecStart=/usr/bin/python3 -u dashboard.py 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
